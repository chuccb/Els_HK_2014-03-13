{
  "name": "els-hk-web",
  "private": true,
  "version": "0.0.0",
  "description": "Elsword HK client (2014-03-13) restored on the Web: TypeScript + Bun + WebGPU. Behaviour follows data/x2.exe (IDA export data/x2.exe.c).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "./tools/lua-difftest.sh && ./tools/gpu.sh bun test packages",
    "verify:kom": "bun run tools/verify-kom.ts",
    "verify:images": "bun run tools/decode-images.ts --tsv /tmp/images_ts.tsv",
    "verify:xet-tet": "bun run tools/verify-xet-tet.ts",
    "verify:xfiles": "bun run tools/verify-xfiles.ts --crosscheck",
    "verify:xparse": "bun run tools/verify-xparse.ts",
    "verify:ksm": "bun run tools/verify-ksm.ts",
    "verify:ksm-load": "./tools/gpu.sh bun run tools/verify-ksm-load.ts",
    "verify:xmesh-load": "./tools/gpu.sh bun run tools/verify-xmesh-load.ts --x 50",
    "verify:optimizekeys": "bun run tools/verify-optimizekeys.ts",
    "mutate:optimizekeys": "python3 tools/mutate-optimizekeys.py",
    "verify:ess": "bun run tools/verify-ess.ts",
    "verify:kim": "bun run tools/verify-kim.ts",
    "verify:mpeg1": "bun run tools/verify-mpeg1.ts",
    "verify:lua": "./tools/lua-difftest.sh && ./tools/corpus-diff.sh 1",
    "docs": "python3 tools/bindings.py && bun run tools/gen-host-api.ts && bun run tools/host-census.ts --md docs/HOST_CENSUS.md && python3 tools/ledger.py",
    "gen:host": "bun run tools/gen-host-api.ts",
    "census:host": "bun run tools/host-census.ts",
    "setup:gpu": "./tools/setup-gpu.sh",
    "setup:browser": "./tools/setup-browser.sh",
    "serve": "bun run apps/server/src/main.ts",
    "test:browser": "bun run tools/browser-test.ts"
  },
  "devDependencies": {
    "@els/assets": "workspace:*",
    "@els/d3d9": "workspace:*",
    "@els/engine": "workspace:*",
    "@els/host": "workspace:*",
    "@els/kom": "workspace:*",
    "@els/lua": "workspace:*",
    "@types/bun": "1.4.4",
    "@webgpu/types": "0.1.74",
    "bun": "1.4.4",
    "fflate": "0.8.3",
    "typescript": "7.1.0-beta",
    "webgpu": "0.6.2"
  },
  "engines": {
    "bun": "1.4.4"
  }
}
