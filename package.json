{
  "name": "els-hk-web",
  "private": true,
  "version": "0.0.0",
  "description": "Elsword HK client (2014-03-13) restored on the Web: TypeScript + Bun + WebGPU. Behaviour follows data/x2.exe (IDA export data/x2.exe.c).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "./tools/lua-difftest.sh && bun test packages/assets",
    "verify:kom": "bun run tools/verify-kom.ts",
    "verify:images": "bun run tools/decode-images.ts --tsv /tmp/images_ts.tsv",
    "verify:xet-tet": "bun run tools/verify-xet-tet.ts",
    "verify:xfiles": "bun run tools/verify-xfiles.ts --crosscheck",
    "verify:xparse": "bun run tools/verify-xparse.ts",
    "verify:ksm": "bun run tools/verify-ksm.ts",
    "verify:ess": "bun run tools/verify-ess.ts",
    "verify:lua": "./tools/lua-difftest.sh && ./tools/corpus-diff.sh 1",
    "docs": "python3 tools/bindings.py && python3 tools/ledger.py"
  },
  "devDependencies": {
    "@els/assets": "workspace:*",
    "@els/kom": "workspace:*",
    "@els/lua": "workspace:*",
    "@types/bun": "1.4.4",
    "@webgpu/types": "0.1.74",
    "bun": "1.4.4",
    "typescript": "7.1.0-beta"
  },
  "engines": {
    "bun": "1.4.4"
  }
}
